{
  "name": "@onta.nicolae/tsql-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Poor Man's T-SQL formatting and sqlcmd tasks for Zed",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "zed-tsql-format": "bin/format.js",
    "zed-mssql": "bin/query.js",
    "zed-tsql-lsp": "bin/lsp.js",
    "zed-tsql-settings": "bin/zed-settings.js"
  },
  "scripts": {
    "test": "node --test",
    "pack:portable": "node scripts/pack.js",
    "test:package": "node scripts/package-smoke.js",
    "configure:release": "node scripts/configure-release.js",
    "check:release": "node scripts/check-release.js",
    "prepublishOnly": "npm run check:release && npm test && npm run test:package"
  },
  "dependencies": {
    "poor-mans-t-sql-formatter": "1.6.10",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "license": "AGPL-3.0-only",
  "files": [
    "bin/",
    "src/",
    "examples/formatter.json",
    "README.md",
    "THIRD_PARTY.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/formatting.md",
    "docs/query-helper.md",
    "docs/portability.md",
    "docs/release-status.md",
    "docs/security-audit.md",
    "PUBLISHING.md",
    "CONTRIBUTING.md",
    "extension/LICENSE",
    "docs/acceptance.md",
    "docs/release-requirements.md",
    "docs/registry-pr.md"
  ],
  "bundledDependencies": [
    "poor-mans-t-sql-formatter",
    "vscode-languageserver",
    "vscode-languageserver-textdocument"
  ],
  "keywords": [
    "zed",
    "sql",
    "tsql",
    "sql-server",
    "formatter",
    "language-server"
  ],
  "author": "Onța Nicolae",
  "repository": {
    "type": "git",
    "url": "https://github.com/chadnicu/zed-tsql-tools.git"
  },
  "homepage": "https://github.com/chadnicu/zed-tsql-tools#readme",
  "bugs": {
    "url": "https://github.com/chadnicu/zed-tsql-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
